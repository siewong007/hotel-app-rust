{
	# Quoted so an unset ACME_EMAIL still parses (empty = no ACME contact email).
	email "{$ACME_EMAIL}"
	servers {
		trusted_proxies static private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

{$DOMAIN} {
	encode zstd gzip

	# Booking access tokens used to travel in the URL (`?token=`). New clients
	# send a header instead; keep logs from retaining leftover query tokens.
	log {
		format filter {
			wrap json
			fields {
				request>uri regexp "(/guest-portal/(?:booking|pre-checkin|auto-checkin)/|/booking/recover-payment/|/communications/unsubscribe/)[A-Za-z0-9._~-]{16,}|([?&]token=)[^&#]+" "${1}${2}REDACTED"
				request>headers>Sec-WebSocket-Protocol delete
				request>headers>X-Booking-Access-Token delete
				request>headers>X-Desktop-Client-Token delete
				request>headers>X-Step-Up delete
				request>headers>X-Backup-Passphrase delete
				resp_headers>Sec-WebSocket-Protocol delete
			}
		}
	}

	# HSTS. '?' sets the header only when absent. Parameterized so local HTTPS
	# (DOMAIN=localhost) can send max-age=0: an HSTS pin
	# on the host "localhost" applies to EVERY port, force-upgrading the plain
	# HTTP Vite dev server on :3000 to https and breaking it (notably in
	# Safari). Unset (production/VPS) the default below preserves the original
	# hardened value byte-for-byte. The backend also sets HSTS on API responses
	# (routes/mod.rs); this edge header covers the frontend host, and '?' keeps
	# the two from duplicating the value.
	header ?Strict-Transport-Security "{$HSTS_VALUE:max-age=31536000; includeSubDomains}"
	header {
		-Server
		?Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?Cross-Origin-Opener-Policy "same-origin"
		?X-Content-Type-Options "nosniff"
		?X-Frame-Options "DENY"
	}

	# Maintenance mode: MAINTENANCE_MODE=on (container env) short-circuits every
	# request except /health — which stays up so deploy smoke checks and uptime
	# probes keep working while the SPA/API are intentionally down.
	@maintenance expression "{$MAINTENANCE_MODE:off}" == "on" && !path("/health")
	handle @maintenance {
		respond "Scheduled maintenance — please try again shortly." 503
	}

	# KEEP IN SYNC with PROXY_PREFIXES in hotel-web-fe/vite.config.ts
	@backend path /api /api/* /uploads /uploads/* /health /ws /ws/* /hotel.*
	handle @backend {
		reverse_proxy backend:3030 {
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		reverse_proxy frontend:80
	}
}
