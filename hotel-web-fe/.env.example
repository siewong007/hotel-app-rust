# Frontend build-time environment (Vite). Copy to .env.local for local overrides;
# Vite only exposes variables prefixed VITE_ to client code (import.meta.env).

# Google Sign-In client ID (see GoogleSignInButton.tsx). Must match the backend's
# GOOGLE_CLIENT_ID (hotel-app-be/.env.example) — they are the same OAuth client.
# Without it, the Google sign-in button renders disabled.
VITE_GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com

# Cloudflare Turnstile SITE key — the public half, safe to ship in the bundle.
# Must match the backend's TURNSTILE_SITE_KEY (hotel-app-be/.env.example).
# Leave it empty to skip the challenge on the login and registration forms.
# NEVER put the Turnstile SECRET key in a VITE_ variable: everything prefixed
# VITE_ is inlined into client code and served to every visitor.
VITE_TURNSTILE_SITE_KEY=

# Optional: override the API base URL. Leave unset for normal dev (Vite proxies
# /api to 127.0.0.1:3030) and for web production (same-origin dynamic routing).
# VITE_API_URL=http://127.0.0.1:3030

# Dev-server proxy upstream override; defaults to VITE_API_URL or http://127.0.0.1:3030.
# VITE_BACKEND_TARGET=http://127.0.0.1:3030

# Comma-separated domains routed over gRPC-Web at build time (e.g. rooms,housekeeping,maintenance,guests; default off).
# VITE_GRPC_CONTEXTS=

# Build runtime target (`web` or `tauri`); defaults to Vite MODE.
# VITE_APP_TARGET=web

# Set to `true` on signed desktop release builds to enable in-app Tauri updater checks.
# VITE_DESKTOP_UPDATER_ENABLED=false
